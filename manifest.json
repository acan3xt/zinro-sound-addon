{
  "manifest_version": 3,
  "name": "zinro.net Sound Add-on",
  "version": "1.0.5",
  "description": "zinro.net の昼・投票・夜タイマー、スレ保守用時間、指定キーワードを音で通知します。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://zinro.net/*"
  ],
  "action": {
    "default_title": "zinro.net Sound Add-on",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://zinro.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "zinro-sound-notifier@local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
